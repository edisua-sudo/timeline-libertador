            eventsHtml += `<div class="absolute ${ev.isCross ? 'top-0 bottom-0 w-[6px] opacity-90 shadow-[0_0_15px_rgba(220,38,38,0.9)] z-0 bg-red-600' : (ev.isMajor ? 'top-[10px] bottom-[20px] w-[5px] opacity-70 shadow-[0_0_8px_currentColor]' : 'top-[20px] bottom-[20px] w-[3px] opacity-30')} ${ev.color} z-10 -translate-x-1/2 transition-all" style="left: ${leftPercent}%;"></div>
                <div class="absolute ${topClass} -translate-x-1/2 bg-white px-2 py-1 rounded z-20 flex flex-col items-center" style="left: ${leftPercent}%;">
                    <i class="fas ${ev.icon} ${ev.color.replace('bg-', 'text-')} mb-0.5 text-base"></i>
                    <span class="${ev.isCross ? 'text-[11px] text-red-700' : (ev.isMajor ? 'text-[11px]' : 'text-[10px]')} font-bold whitespace-nowrap text-slate-800">${ev.name}</span>
                </div>`;
        });
        eventsContainer.innerHTML = eventsHtml;

        // Funciones para el resaltado en grupo del mensaje oculto
        window.highlightAllMessages = () => {
            document.querySelectorAll('.hidden-message-part').forEach(el => el.classList.add('active-group'));
        };
        
        window.unhighlightAllMessages = () => {
            document.querySelectorAll('.hidden-message-part').forEach(el => el.classList.remove('active-group'));
        };

        const barsContainer = document.getElementById('bars-container');
        window.sortedEntities.forEach((ent, index) => {
            const startPct = (ent.birthAM / MAX_YEAR) * 100;
            const widthPct = ((ent.deathAM - ent.birthAM) / MAX_YEAR) * 100;
            const isGlowing = ent.name === "JESUCRISTO" || ent.name === "Enoc";
            const topY = PEOPLE_START_Y + (ent.row * ROW_HEIGHT);
            
            const barStyles = isGlowing 
                ? "bg-gradient-to-r from-orange-400 via-orange-600 to-red-600 border border-orange-500 jesus-glow" 
                : (ent.color || "bg-blue-500");
            
            let barHeight = 6;

            if (isGlowing) {
                if (ent.name === "JESUCRISTO") barHeight = 16;
                if (ent.name === "Enoc") barHeight = 8;
            }

            let iconColorClass = ent.color || "bg-blue-500";
            if (isGlowing) {
                iconColorClass = "bg-orange-600";
            }
            
            // Construir el HTML de la frase oculta si existe
            const hiddenMsgHtml = ent.hiddenMessage 
                ? `<div class="hidden-message-part whitespace-nowrap pointer-events-auto" onmouseenter="highlightAllMessages()" onmouseleave="unhighlightAllMessages()">${ent.hiddenMessage}</div>` 
                : '';
            
            let eventsDotsHtml = '';
            if (ent.events) {
                ent.events.forEach((ev) => {
                    const evPct = ((Math.max(ent.birthAM, ev.year) - ent.birthAM) / (ent.deathAM - ent.birthAM)) * 100;
                    const safeTitle = (ev.title || '').replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/"/g, "&quot;").replace(/\n/g, ' ');
                    const safeDesc = (ev.desc || '').replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/"/g, "&quot;").replace(/\n/g, ' ');

                    eventsDotsHtml += `<div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 event-diamond rotate-45 cursor-help hover:scale-150 transition-transform z-40" 
                             style="left: ${evPct}%;" 
                             onmouseenter="showEventTooltip(event, '${safeTitle}', '${safeDesc}')" 
                             onmouseleave="hideEventTooltip()"></div>`;
                });
            }

            const iconHtml = ent.isEmpire 
                ? `<i class="fas ${ent.icon} text-[11px] ${ent.color.replace('bg-', 'text-')} shrink-0"></i>`
                : `<div class="w-4 h-4 rounded-full ${iconColorClass} flex items-center justify-center shrink-0 shadow-sm border border-white"><i class="fas fa-user text-[8px] text-white"></i></div>`;

            barsContainer.insertAdjacentHTML('beforeend', `<div class="patriarch-bar absolute group z-30 flex items-center pointer-events-none" style="left: ${startPct}%; top: ${topY}px; width: ${widthPct}%; height: 40px;" data-birth="${ent.birthAM}" data-death="${ent.deathAM}">
                    <div class="absolute left-0 top-[30px] flex items-center gap-1.5 name-container z-50 pointer-events-auto">
                        <div class="flex items-center gap-1.5" onmouseenter="showTooltip(event, ${index})" onmouseleave="hideTooltip()">
                            ${iconHtml}
                            <div class="name-label text-[13px] font-bold text-slate-800 whitespace-nowrap tracking-wide uppercase px-1.5 py-0.5 rounded transition-all duration-200 bg-white/60 backdrop-blur-[2px] pointer-events-auto">${ent.name}</div>
                        </div>
                        ${hiddenMsgHtml}
                    </div>
                    <div class="bar-line w-full ${barStyles} rounded-full relative transition-all duration-300 pointer-events-auto shadow-sm" style="height: ${barHeight}px;">${eventsDotsHtml}</div>
                </div>`);
        });

        const booksContainer = document.getElementById('books-container');
        let booksHtml = '';
        bibleBooks.forEach(book => {
            const startPct = (book.startAM / MAX_YEAR) * 100;
            const widthPct = ((book.endAM - book.startAM) / MAX_YEAR) * 100;
            booksHtml += `<div class="absolute flex flex-col items-center group/book hover:z-50 pointer-events-auto" style="left: ${startPct}%; width: ${widthPct}%; top: ${book.level * 26}px;">
                    <div class="w-full h-[3px] bg-amber-800/50 rounded-full group-hover/book:bg-amber-600 group-hover/book:h-[5px] transition-all"></div>
                    <span class="text-[10px] font-bold text-amber-900 mt-0.5 px-2 bg-white/90 border border-amber-200/50 rounded shadow-sm whitespace-nowrap group-hover/book:bg-amber-100 group-hover/book:scale-110 transition-all origin-top cursor-default">${book.name}</span>
                </div>`;
        });
        booksContainer.innerHTML = booksHtml;

        const zoomSlider = document.getElementById('zoom-slider');
        zoomSlider.addEventListener('input', (e) => chartContainer.style.width = e.target.value + 'px');

        const drawArea = document.getElementById('chart-draw-area');
        const timeCursor = document.getElementById('time-cursor');
        const tcLabels = { amT: document.getElementById('tc-am-top'), acT: document.getElementById('tc-ac-top'), amB: document.getElementById('tc-am-bottom'), acB: document.getElementById('tc-ac-bottom') };
        
        drawArea.addEventListener('mousemove', (e) => {
            const rect = drawArea.getBoundingClientRect();
            let x = e.clientX - rect.left;
            const pct = Math.max(0, Math.min(1, x / rect.width));
            const year = Math.round(pct * MAX_YEAR);
            const yearAC = amToAC(year);
            const acText = yearAC >= 0 ? (yearAC + ' a.C.') : (Math.abs(yearAC) + ' d.C.');

            timeCursor.style.left = (pct * 100) + '%';
            tcLabels.amT.innerText = tcLabels.amB.innerText = year + ' AM';
            tcLabels.acT.innerText = tcLabels.acB.innerText = acText;
            timeCursor.classList.remove('hidden');

            document.querySelectorAll('.patriarch-bar').forEach(bar => {
                const birth = parseInt(bar.getAttribute('data-birth')), death = parseInt(bar.getAttribute('data-death'));
                bar.classList.toggle('highlighted', year >= birth && year <= death);
            });
        });

        drawArea.addEventListener('mouseleave', () => {
            timeCursor.classList.add('hidden');
            document.querySelectorAll('.patriarch-bar').forEach(bar => bar.classList.remove('highlighted'));
        });

        window.showTooltip = (e, i) => {
            const p = window.sortedEntities[i];
            const age = p.deathAM - p.birthAM;
            const birthAC = amToAC(p.birthAM);
            const deathAC = amToAC(p.deathAM);
            const birthLabel = birthAC >= 0 ? `${birthAC} a.C.` : `${Math.abs(birthAC)} d.C.`;
            const deathLabel = deathAC >= 0 ? `${deathAC} a.C.` : `${Math.abs(deathAC)} d.C.`;

            document.getElementById('tt-age').innerText = `${age} años (${birthLabel} - ${deathLabel})`;
            document.getElementById('tt-role').innerText = p.role;
            const tt = document.getElementById('tooltip');
            tt.style.left = e.clientX + 'px'; tt.style.top = (e.clientY - 15) + 'px'; tt.style.opacity = '1';
        };
        window.hideTooltip = () => document.getElementById('tooltip').style.opacity = '0';

        window.showEventTooltip = (e, title, desc) => {
            document.getElementById('ev-tt-title').innerText = title;
            document.getElementById('ev-tt-desc').innerText = desc;
            const ett = document.getElementById('event-tooltip');
            ett.style.left = e.clientX + 'px'; ett.style.top = (e.clientY - 30) + 'px'; ett.style.opacity = '1';
        };
        window.hideEventTooltip = () => document.getElementById('event-tooltip').style.opacity = '0';
    </script>
</body>
</html>
