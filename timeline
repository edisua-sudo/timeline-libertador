<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cronología del Libertador</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Roboto Condensed', sans-serif;
            background-color: #fdfbf7;
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d4c5b0' fill-opacity='0.15'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            margin: 0;
            overflow: hidden; 
        }

        .timeline-scroll {
            scrollbar-width: thin;
            scrollbar-color: #3b82f6 #f1f5f9;
        }
        .timeline-scroll::-webkit-scrollbar { height: 12px; width: 12px; }
        .timeline-scroll::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 6px; }
        .timeline-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 6px; border: 2px solid #f1f5f9; }
        .timeline-scroll::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        #tooltip, #event-tooltip { transition: opacity 0.15s ease-in-out; z-index: 9999; }
        
        .patriarch-bar { transition: all 0.2s ease; }
        
        .patriarch-bar.highlighted { z-index: 50 !important; }
        .patriarch-bar.highlighted .bar-line {
            transform: scaleY(1.3);
            filter: brightness(1.1);
        }
        .patriarch-bar.highlighted .name-label {
            color: #ffffff !important; 
            background-color: #1e293b !important;
            transform: scale(1.05);
        }
        
        .patriarch-bar:hover .bar-line {
            transform: scaleY(1.5);
            filter: brightness(1.2);
        }

        .event-diamond {
            width: 12px;
            height: 12px;
            background-color: white;
            border: 2px solid #0f172a; 
            box-shadow: 0 0 6px rgba(0,0,0,0.4);
        }

        /* Estilos para el mensaje oculto interactivo en la línea de tiempo */
        .hidden-message-part {
            color: #b45309; /* amber-700 */
            font-size: 12px;
            font-style: italic;
            padding: 2px 6px;
            border-radius: 4px;
            background-color: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(2px);
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }

        .hidden-message-part.active-group {
            background-color: #9a3412 !important; /* orange-800 - dark orange */
            color: #ffffff !important;
            transform: scale(1.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
            font-weight: 600;
        }

        .jesus-glow {
            animation: pulse-glow 2s infinite alternate;
        }
        @keyframes pulse-glow {
            from { box-shadow: 0 0 10px rgba(234, 88, 12, 0.6); }
            to { box-shadow: 0 0 30px rgba(234, 88, 12, 1); }
        }
    </style>
</head>
<body class="text-slate-800 antialiased h-screen flex flex-col">

    <div class="fixed bottom-6 left-6 z-50 flex flex-col gap-3">
        <button id="toggle-books-btn" class="bg-white/95 backdrop-blur shadow-xl rounded-full px-5 py-3 border border-amber-300 text-amber-800 font-bold text-sm cursor-pointer hover:bg-amber-100 transition-colors flex items-center gap-2">
            <i class="fas fa-book-open"></i> Libros Bíblicos
        </button>
    </div>

    <div class="fixed bottom-6 right-6 z-50 group">
        <div class="bg-white/95 backdrop-blur shadow-xl rounded-full w-14 h-14 flex items-center justify-center border border-amber-300 text-amber-700 cursor-pointer hover:bg-amber-50 hover:scale-105 transition-all group-hover:rounded-br-none">
            <i class="fas fa-search-plus text-2xl"></i>
        </div>
        <div class="absolute bottom-full right-0 mb-3 bg-white/95 backdrop-blur shadow-2xl rounded-xl p-5 border border-amber-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform origin-bottom-right group-hover:translate-y-0 translate-y-2 flex flex-col items-center gap-3">
            <label for="zoom-slider" class="text-xs font-bold text-slate-700 uppercase tracking-wide">Ajustar Escala</label>
            <div class="flex items-center gap-3">
                <i class="fas fa-compress-alt text-slate-400"></i>
                <input type="range" id="zoom-slider" min="2000" max="15000" value="6500" class="w-48 accent-amber-600 cursor-pointer">
                <i class="fas fa-expand-alt text-slate-400"></i>
            </div>
        </div>
    </div>

    <main class="w-full h-screen overflow-auto timeline-scroll relative pb-10 px-4 md:px-10 pt-2">
        <div id="chart-container" class="relative bg-white/60 border border-slate-300 shadow-inner rounded-xl mx-auto overflow-hidden px-[30px] transition-all duration-300 ease-out" style="width: 6500px;">
            <div id="chart-draw-area" class="relative w-full h-full cursor-crosshair">
                
                <div id="bg-esclavitud" class="absolute top-0 bottom-0 bg-[#eedaab]/30 z-0 border-l border-r border-[#d4b986] pointer-events-none transition-all">
                    <div class="absolute top-6 left-1/2 -translate-x-1/2 text-[#a88241] font-bold text-xs uppercase tracking-widest whitespace-nowrap bg-white/60 px-2 py-0.5 rounded backdrop-blur-sm">
                        <i class="fas fa-link text-[10px] mr-1"></i> Esclavitud en Egipto
                    </div>
                </div>

                <div id="bg-jueces" class="absolute top-0 bottom-0 bg-[#dcfce7]/40 z-0 border-l border-r border-[#86efac]/50 pointer-events-none transition-all">
                    <div class="absolute top-6 left-1/2 -translate-x-1/2 text-[#166534] font-bold text-xs uppercase tracking-widest whitespace-nowrap bg-white/60 px-2 py-0.5 rounded backdrop-blur-sm shadow-sm">
                        <i class="fas fa-balance-scale text-[10px] mr-1"></i> Época de los Jueces
                    </div>
                </div>

                <div id="bg-reyes" class="absolute top-0 bottom-0 bg-[#f3e8ff]/40 z-0 border-l border-r border-[#d8b4fe]/50 pointer-events-none transition-all">
                    <div class="absolute top-6 left-1/2 -translate-x-1/2 text-[#6b21a8] font-bold text-xs uppercase tracking-widest whitespace-nowrap bg-white/60 px-2 py-0.5 rounded backdrop-blur-sm shadow-sm">
                        <i class="fas fa-crown text-[10px] mr-1"></i> Época de los Reyes
                    </div>
                </div>

                <div id="bg-exilio" class="absolute top-0 bottom-0 bg-[#fef08a]/30 z-0 border-l border-r border-[#fde047]/50 pointer-events-none transition-all">
                    <div class="absolute top-6 left-1/2 -translate-x-1/2 text-[#854d0e] font-bold text-xs uppercase tracking-widest whitespace-nowrap bg-white/60 px-2 py-0.5 rounded backdrop-blur-sm shadow-sm">
                        <i class="fas fa-link text-[10px] mr-1"></i> Exilio en Babilonia
                    </div>
                </div>

                <div id="bg-jesus" class="absolute top-0 bottom-0 bg-[#fef9c3]/50 z-0 border-l border-r border-[#fde047]/60 pointer-events-none transition-all">
                    <div class="absolute top-6 left-1/2 -translate-x-1/2 text-[#a16207] font-bold text-xs uppercase tracking-widest whitespace-nowrap bg-white/70 px-2 py-0.5 rounded backdrop-blur-sm shadow-sm">
                        <i class="fas fa-star text-[10px] mr-1"></i> Vida de Jesucristo
                    </div>
                </div>

                <div id="grid-bg" class="absolute inset-0 pointer-events-none z-0"></div>
                <div id="grid-top-labels" class="sticky top-0 w-full h-0 z-[60] pointer-events-none"></div>
                <div id="grid-bottom-labels" class="sticky bottom-0 w-full h-0 z-[60] pointer-events-none"></div>
                <div id="events-container" class="absolute inset-0 z-10 pointer-events-none"></div>
                <div class="absolute top-[0px] bottom-[20px] left-0 w-[3px] bg-red-600 z-10 pointer-events-none"></div>
                <div id="bars-container" class="absolute inset-0 z-20 pointer-events-none"></div>

                <div id="time-cursor" class="absolute top-0 bottom-0 w-[2px] bg-amber-500/80 shadow-[0_0_8px_rgba(245,158,11,0.5)] hidden pointer-events-none z-30 transform -translate-x-1/2 transition-opacity duration-200">
                    <div class="sticky top-0 w-full h-0 overflow-visible z-[70]">
                        <div class="absolute top-12 left-1/2 transform -translate-x-1/2 bg-amber-600 text-white text-[11px] font-bold px-2 py-1.5 rounded shadow whitespace-nowrap flex flex-col items-center">
                            <span id="tc-am-top" class="leading-none">0 AM</span>
                            <span id="tc-ac-top" class="text-[11px] text-amber-200 mt-1 leading-none">4004 a.C.</span>
                        </div>
                    </div>
                    <div class="sticky bottom-0 w-full h-0 overflow-visible z-[70]">
                        <div class="absolute bottom-12 left-1/2 transform -translate-x-1/2 bg-slate-700 text-white text-[11px] font-bold px-2 py-1.5 rounded shadow whitespace-nowrap flex flex-col items-center">
                            <span id="tc-am-bottom" class="leading-none">0 AM</span>
                            <span id="tc-ac-bottom" class="text-[11px] text-slate-400 mt-1 leading-none">4004 a.C.</span>
                        </div>
                    </div>
                </div>

                <div id="books-wrapper" class="absolute bottom-0 left-0 right-0 h-0 opacity-0 transition-all duration-300 border-t border-dashed border-amber-900/30 bg-gradient-to-t from-[#e8dcc4] to-transparent pointer-events-none">
                    <div id="books-container" class="absolute inset-0 pt-4"></div>
                </div>

            </div>
        </div>
    </main>

    <div id="tooltip" class="fixed opacity-0 pointer-events-none bg-white border border-amber-300 shadow-2xl rounded-lg p-3 w-[260px] transform -translate-x-1/2 -translate-y-full mt-[-15px] z-[9999]">
        <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-0 h-0 border-l-[8px] border-l-transparent border-t-[8px] border-t-amber-300 border-r-[8px] border-r-transparent"></div>
        <div class="absolute -bottom-[7px] left-1/2 -translate-x-1/2 w-0 h-0 border-l-[7px] border-l-transparent border-t-[7px] border-t-white border-r-[7px] border-r-transparent"></div>
        
        <div class="text-center mb-1">
            <span id="tt-age" class="font-bold text-blue-800 text-[13px] bg-slate-50 px-2 py-1 rounded border border-slate-100 block"></span>
        </div>
        <div class="pt-1 text-center">
            <p id="tt-role" class="text-slate-600 text-[13px] leading-snug"></p>
        </div>
    </div>

    <div id="event-tooltip" class="fixed opacity-0 pointer-events-none bg-slate-800 text-white p-3 rounded-lg text-sm shadow-2xl w-72 transform -translate-x-1/2 -translate-y-full mt-[-10px] z-[10000] border border-slate-600">
        <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-0 h-0 border-l-[8px] border-l-transparent border-t-[8px] border-t-slate-800 border-r-[8px] border-r-transparent"></div>
        <strong id="ev-tt-title" class="block text-amber-300 font-bold uppercase mb-1 border-b border-slate-600 pb-1"></strong>
        <p id="ev-tt-desc" class="text-slate-200 leading-snug mt-1 text-[13px]"></p>
    </div>

    <script>
        const MAX_YEAR = 4100;

        // --- 1. DATOS UNIFICADOS ---
        const timelineEntities = [
            { name: "Adán", birthAM: 0, deathAM: 930, role: "El primer portador de la imagen de Dios, tras la caída, recibió la promesa del Libertador que heriría la cabeza de la serpiente.", hiddenMessage: "(El) hombre (es)", events: [{ year: 120, title: "Caín mata a Abel", desc: "Caín mató a Abel antes de que Adán cumpliera 130 años." }] },
            { name: "Set", birthAM: 130, deathAM: 1042, role: "La simiente designada por Dios para preservar la esperanza del Libertador tras la pérdida de Abel.", hiddenMessage: "concedido", events: [] },
            { name: "Enós", birthAM: 235, deathAM: 1140, role: "Aquel que reconoció la fragilidad humana, impulsando a la humanidad a invocar el nombre del Señor en busca de su Salvador.", hiddenMessage: "mortal", events: [] },
            { name: "Cainán", birthAM: 325, deathAM: 1235, role: "El recordatorio de que, en medio del lamento por el pecado, la mayor posesión del hombre es la promesa de rescate.", hiddenMessage: "tristeza", events: [] },
            { name: "Mahalaleel", birthAM: 395, deathAM: 1290, role: "Aun en un mundo caído, la fidelidad de Dios al cumplir Su promesa es motivo de eterna alabanza.", hiddenMessage: "(pero el) Dios bendito", events: [] },
            { name: "Jared", birthAM: 460, deathAM: 1422, role: "Una sombra profética de Aquel que, siendo Dios, habría de descender de su trono para habitar entre los hombres y redimirlos.", hiddenMessage: "vendrá a nosotros", events: [] },
            { name: "Enoc", birthAM: 622, deathAM: 987, role: "El hombre que caminó con Dios, enseñando que la verdadera vida se encuentra en la comunión con el Prometido.", note: "Trasladado", hiddenMessage: "enseñando", events: [{ year: 987, title: "Trasladado (Judas 14-15)", desc: "Enoc profetizó el juicio; desapareció porque Dios se lo llevó." }] },
            { name: "Matusalén", birthAM: 687, deathAM: 1656, role: "Su nombre significa 'cuando él muera, vendrá (el juicio del pecado)'. El símbolo de la paciencia divina, cuya vida anunció que solo a través de una muerte necesaria vendría la renovación del mundo.", hiddenMessage: "(que) su muerte traerá", events: [] },
            { name: "Lamec", birthAM: 874, deathAM: 1651, role: "Aquel que expresó el agotamiento por la maldición de la tierra, suspirando por el alivio que el Libertador traería.", hiddenMessage: "(a los) desesperados", events: [] },
            { name: "Noé", birthAM: 1056, deathAM: 2006, role: "El tipo del Mesías que, al atravesar el juicio, preservó la vida y trajo el verdadero descanso a la humanidad.", hiddenMessage: "consolación o descanso.", events: [{ year: 1656, title: "El Diluvio", desc: "Dios cumple su juicio pero preserva la humanidad por amor a su promesa." }] },
            { name: "Sem (Nombre/Renombre)", birthAM: 1558, deathAM: 2158, role: "El portador de la bendición de Noé, de cuyo linaje vendría aquel cuyo 'Nombre' es sobre todo nombre para restaurar la gloria perdida.", events: [] },
            { name: "Arfaxad (Fortaleza/Sanador)", birthAM: 1658, deathAM: 2096, role: "La semilla que brotó con fuerza tras el juicio del diluvio, preservando la línea elegida para la sanación de todas las naciones.", events: [] },
            { name: "Sala (Petición/Brote)", birthAM: 1693, deathAM: 2126, role: "Un eslabón que se extiende como un brote hacia el futuro, manteniendo viva la petición de la humanidad por un redentor.", events: [] },
            { name: "Heber (El que cruza/Del otro lado)", birthAM: 1723, deathAM: 2187, role: "Ancestro epónimo de los hebreos, aquel que nos recuerda que el pueblo del Libertador son peregrinos que cruzan de la muerte a la vida.", events: [] },
            { name: "Peleg (División)", birthAM: 1757, deathAM: 1996, role: "Aunque el mundo se dividió en Babel, su vida marcó la separación de un linaje apartado exclusivamente para el cumplimiento de la promesa.", events: [] },
            { name: "Reu (Amigo/Compañero)", birthAM: 1787, deathAM: 2026, role: "Un recordatorio de que el objetivo final de la redención es restaurar la amistad y la comunión entre el Creador y su creación.", events: [] },
            { name: "Serug (Rama/Brote)", birthAM: 1819, deathAM: 2049, role: "Una prefiguración de la 'Rama' justa que habría de nacer para dar sombra y descanso a un mundo fatigado por el pecado.", events: [] },
            { name: "Nacor (Anhelante/Respirar fuerte)", birthAM: 1849, deathAM: 1997, role: "El testimonio de una creación que gime y anhela profundamente el aliento de vida que solo el Mesías puede otorgar.", events: [] },
            { name: "Taré (Estación/Viajero)", birthAM: 1878, deathAM: 2083, role: "Padre de Abraham. Representa el momento de tránsito y salida de la idolatría antigua hacia el camino de la fe que conduce a la Tierra Prometida.", events: [] },
            { name: "Abraham (Padre de multitudes)", birthAM: 2008, deathAM: 2183, role: "El hombre del pacto, a quien se le prometió que en su 'Simiente' (el Libertador) serían benditas todas las familias de la tierra.", events: [{ year: 2108, title: "Nace Isaac", desc: "Nacimiento del hijo de la promesa a los 100 años de Abraham." }], priority: 10 },
            { name: "Isaac (Risa)", birthAM: 2108, deathAM: 2288, role: "El hijo del milagro y el sacrificio, cuya obediencia en el monte Moriá señaló al Cordero de Dios que quitaría el pecado del mundo.", priority: 5, events: [] },
            { name: "Jacob (Sostenido por el talón/Israel)", birthAM: 2168, deathAM: 2315, role: "El patriarca que luchó con Dios y prevaleció pero solo cuando se vio vencido", events: [] },
            { name: "Leví (Unido)", birthAM: 2255, deathAM: 2392, role: "El antecesor del sacerdocio, cuya función apunta al Mediador perfecto que uniría para siempre a Dios con su pueblo.", events: [] },
            { name: "Judá (Alabanza)", birthAM: 2256, deathAM: 2385, role: "El portador del cetro real, de cuya tribu nacería el 'León de Judá' para gobernar con justicia y misericordia eterna.", events: [] },
            { name: "José (Que Dios añada)", birthAM: 2259, deathAM: 2369, role: "El hijo amado, rechazado y exaltado a salvador, que tipifica al Libertador que provee el 'Pan de Vida' incluso a quienes lo traicionaron.", events: [] },
            { name: "Aarón (Iluminado/Excelso)", birthAM: 2430, deathAM: 2552, role: "El primer Sumo Sacerdote, cuya intercesión y vestiduras gloriosas reflejaban la luz del que vendría a ofrecer el sacrificio definitivo.", events: [] },
            { name: "Moisés (Sacado de las aguas)", birthAM: 2433, deathAM: 2553, role: "El mediador de la Ley y el libertador del Éxodo, quien anunció que Dios levantaría a un Profeta mayor que él para guiar al pueblo a la libertad total.", events: [{ year: 2513, title: "La Ley", desc: "La Ley fue dada 50 días después de la salida de Egipto." }] },

            { name: "Los Jueces", birthAM: 2553, deathAM: 2909, role: "Líderes levantados para liberar a Israel.", color: "bg-teal-500", events: [
                { year: 2593, title: "Otoniel (León de Dios)", desc: "El primer juez que manifestó la fuerza del Espíritu para dar reposo a la tierra, prefigurando al 'León de la tribu de Judá' que vencerá a todos nuestros opresores." },
                { year: 2653, title: "Aod (Unido/Elogio)", desc: "El libertador que trajo una victoria singular y sorprendente, recordándonos que el Mesías vendría de forma inesperada para herir mortalmente al enemigo de nuestras almas." },
                { year: 2673, title: "Samgar (Espada/Forastero)", desc: "Mató a 600 filisteos con una aguijada de bueyes. quel que con una herramienta humilde salvó a Israel, señalando que el Libertador no necesitaría de ejércitos humanos, sino del poder de Su propia palabra para darnos la victoria." },
                { year: 2713, title: "Débora (Abeja/Palabra)", desc: "La profetisa cuya sabiduría trajo orden y dirección, representando la dulzura y el aguijón de la Palabra de Dios que guía al pueblo hacia su redención." },
                { year: 2753, title: "Gedeón (Guerrero/Talador)", desc: "Venció a los madianitas con solo 300 hombres. El que derribó los altares falsos y venció con un pequeño remanente, tipificando al Libertador que conquista no con espada, sino con la luz y el estruendo de Su sacrificio." },
                { year: 2796, title: "Tola (Gusano/Carmesí)", desc: "Juzgó a Israel 23 años. como en el Salmo 22, aquel que dio paz a Israel durante años, recordándonos el precio 'carmesí' que el Libertador pagaría por nuestra paz." },
                { year: 2818, title: "Jair (Él ilumina)", desc: "Aquel cuyo nombre y descendencia trajeron estabilidad, reflejando al Mesías como la 'Luz del mundo' que disipa las tinieblas de la confusión espiritual." },
                { year: 2836, title: "Jefté (Él abre/Dios libera)", desc: "El hombre rechazado que se convirtió en cabeza y salvador, una imagen clara de la 'piedra que desecharon los edificadores' y que Dios abrió como camino de libertad." },
                { year: 2843, title: "Ibzán (Espléndido/Ilustre)", desc: "Su vida llena de descendencia y paz en Belén (curiosamente la ciudad del Mesías) apunta al esplendor del Reino que el Libertador establecería para Sus hijos." },
                { year: 2853, title: "Elón (Roble/Fuerte)", desc: "Representa la firmeza y la estabilidad de la promesa divina que permanece inamovible a pesar de la infidelidad constante del pueblo." },
                { year: 2861, title: "Abdón (Servicio/Siervo)", desc: "Un recordatorio de que el verdadero liderazgo en el Reino de Dios se manifiesta en el servicio, prefigurando al 'Siervo Sufriente' que daría Su vida por muchos." },
                { year: 2881, title: "Sansón (Del sol/Pequeño sol)", desc: "El nazareo de fuerza sobrenatural que, a través de su propia muerte, destruyó a más enemigos que en toda su vida; el tipo más dramático del Libertador que vence al morir." }
            ] },
            { name: "Samuel (Escuchado por Dios)", birthAM: 2880, deathAM: 2994, role: "El profeta que cerró la era de los jueces y ungió a los reyes, representando al Libertador que escucha el clamor de Su pueblo y establece un Reino eterno de justicia.", color: "bg-teal-600", events: [] },
            
            // Ajuste de los Reyes: Vinculamos Saúl a Los Jueces para iniciar la escalera
            { name: "Rey Saúl", birthAM: 2954, deathAM: 2994, role: "Primer rey de Israel.", color: "bg-purple-500", events: [], linkRowWith: "Los Jueces" },
            { name: "Rey David", birthAM: 2994, deathAM: 3034, role: "Recibió el pacto davídico mesiánico.", color: "bg-purple-600", events: [] },
            { name: "Rey Salomón", birthAM: 3034, deathAM: 3074, role: "Construyó el Templo.", color: "bg-purple-500", 
            events: 
            [{ year: 3044, title: "1er Templo (960 a.C.)", desc: "Finaliza la construcción del Templo de Salomón en Jerusalén." }] },
            
            { name: "Reino de Israel", birthAM: 3074, deathAM: 3282, role: "Reino de 10 tribus. Exiliados por Asiria.", color: "bg-orange-500", events: [{ year: 3282, title: "Deportación a Asiria (722 a.C.)", desc: "Caída y deportación de las 10 tribus." }] },
            { name: "Reino de Judá", birthAM: 3074, deathAM: 3416, role: "Reino de 2 tribus. Linaje de David.", color: "bg-red-500", 
            events: [
                { year: 3094, title: "Asa (910 a.C.)", desc: "El primer reformador; eliminó ídolos y restauró el pacto con Dios." },
                { year: 3132, title: "Josafat (872 a.C.)", desc: "Estableció un sistema judicial y educativo basado en la Ley de Dios." },
